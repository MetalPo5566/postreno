---
import Icon from './Icon.astro'
import type { PostRenoCopy } from '../data/copy/types'

// Every formaldehyde claim on the page traces to one of these documents. The
// IARC classification is stated here once and deliberately nowhere else: it
// belongs in a sources block, not in a headline.
interface Props {
  copy: PostRenoCopy
}
const { copy } = Astro.props as Props
---

<div class="mx-auto max-w-3xl">
  <ol class="flex flex-col gap-5">
    {
      copy.sources.items.map((item, index) => (
        <li class="rounded-card border border-brand-line bg-white p-6 shadow-soft" data-reveal>
          <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-brand-ink">
            {copy.sources.label} {index + 1}
          </p>
          <p class="mt-2 text-[16px] leading-relaxed text-navy">{item.claim}</p>
          <p class="mt-3 text-[15px] leading-relaxed">
            <a
              href={item.url}
              class="font-bold text-brand-ink underline underline-offset-4"
              rel="noopener nofollow"
              target="_blank"
            >
              {item.source}
            </a>
          </p>
        </li>
      ))
    }
  </ol>

  <p class="mt-6 rounded-card border border-brand-line bg-white p-6 text-[15px] leading-relaxed shadow-soft" data-reveal>
    {copy.sources.carcinogen}
  </p>

  <p class="mt-5 flex gap-3 rounded-card bg-brand-tint p-6 text-[15px] leading-relaxed text-navy" data-reveal>
    <Icon name="shield" size={20} class="mt-0.5 shrink-0 text-brand-dark" />
    <span>{copy.sources.note}</span>
  </p>
</div>
