---
import Button from './Button.astro'
import Icon from './Icon.astro'
import { whatsappLink } from '../data/site'
import type { PostRenoCopy } from '../data/copy/types'

interface Props {
  copy: PostRenoCopy
  service: string
}
const { copy, service } = Astro.props as Props
const { steps, bookHere, ctaTitle, ctaText, ctaButton } = copy.window
---

<div>
  <ol class="relative flex flex-col gap-5 md:gap-6">
    {
      steps.map((step, index) => (
        <li
          class={`relative flex gap-4 rounded-card border p-5 md:gap-6 md:p-7 ${
            step.ours
              ? 'border-brand-dark/30 bg-brand-tint shadow-soft ring-1 ring-brand-dark/10'
              : 'border-brand-line bg-white shadow-soft'
          }`}
          data-reveal
        >
          <span
            class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-[17px] font-black md:h-12 md:w-12 ${
              step.ours ? 'bg-brand-dark text-white' : 'bg-brand-circle text-brand-dark'
            }`}
            aria-hidden="true"
          >
            {step.ours ? <Icon name="sparkle" size={22} /> : index + 1}
          </span>
          <div>
            <h3 class="text-[18px] font-bold md:text-[20px]">
              {step.title}
              {step.ours && (
                <span class="ml-2.5 inline-block rounded-full bg-brand-dark px-2.5 py-0.5 align-middle text-[12px] font-black uppercase tracking-wide text-white">
                  {bookHere}
                </span>
              )}
            </h3>
            <p class="mt-1.5 text-[16px] leading-relaxed">{step.text}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <div
    class="mt-8 rounded-card border-2 border-brand-line bg-white p-6 text-center shadow-soft md:p-8"
    data-reveal
  >
    <h3 class="text-[21px] font-black md:text-[24px]">{ctaTitle}</h3>
    <p class="mx-auto mt-2.5 max-w-xl text-[16px] leading-relaxed md:text-[17px]">{ctaText}</p>
    <div class="mt-6 flex justify-center">
      <Button
        href={whatsappLink(copy.hero.waHandover)}
        variant="whatsapp"
        icon="whatsapp"
        cta="whatsapp"
        service={service}
      >
        {ctaButton}
      </Button>
    </div>
  </div>
</div>
