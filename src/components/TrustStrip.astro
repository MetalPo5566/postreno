---
import Icon from './Icon.astro'
import type { IconName } from './Icon.astro'
import { TRUST, SITE } from '../data/site'

// The claims themselves are fixed, published facts. Only their wording is
// passed in, so the Chinese page is not an English strip with Chinese around it.
interface Props {
  items?: readonly { icon: string; title: string; text: string }[]
  policy?: { text: string; linkLabel: string }
}
const {
  items = TRUST,
  policy = { text: 'Read our', linkLabel: 'anti-theft policy' },
} = Astro.props as Props
---

<section class="border-y border-brand-line bg-brand-tint py-10 md:py-12">
  <div class="wrap">
    <ul class="grid grid-cols-2 gap-x-5 gap-y-7 md:grid-cols-3 lg:grid-cols-6">
      {
        items.map((item) => (
          <li class="flex flex-col items-center gap-3 text-center" data-reveal>
            <span class="flex h-14 w-14 items-center justify-center rounded-full bg-brand-circle text-brand-dark">
              <Icon name={item.icon as IconName} size={26} />
            </span>
            <span>
              <span class="block text-[15px] font-bold text-navy">{item.title}</span>
              <span class="mt-1 block text-[14px] leading-snug">{item.text}</span>
            </span>
          </li>
        ))
      }
    </ul>
    <p class="mt-8 text-center text-[14px]">
      {policy.text}{' '}<a
        href={SITE.antiTheftUrl}
        class="font-bold text-brand-ink underline underline-offset-4">{policy.linkLabel}</a
      >.
    </p>
  </div>
</section>
