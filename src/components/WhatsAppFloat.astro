---
import Icon from './Icon.astro'

// Desktop counterpart to the mobile sticky bar.
interface Props {
  whatsappHref: string
  service: string
}
const { whatsappHref, service } = Astro.props as Props
---

<a
  href={whatsappHref}
  class="group fixed bottom-7 right-7 z-40 hidden h-16 w-16 items-center justify-center rounded-full bg-wa text-navy shadow-[0_8px_28px_-6px_rgb(0_120_50/0.5)] transition-transform duration-200 ease-[cubic-bezier(0.23,1,0.32,1)] hover:scale-105 active:scale-95 motion-reduce:hover:scale-100 motion-reduce:active:scale-100 md:flex"
  data-cta="whatsapp"
  data-service={service}
  target="_blank"
  rel="noopener"
  aria-label="Chat with Kleaner on WhatsApp"
>
  <Icon name="whatsapp" size={32} />
</a>
