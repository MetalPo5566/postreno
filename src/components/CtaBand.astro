---
import Button from './Button.astro'
import Icon from './Icon.astro'
import { SITE } from '../data/site'

interface Props {
  title: string
  text: string
  whatsappHref: string
  service: string
}
const { title, text, whatsappHref, service } = Astro.props as Props
---

<section class="bg-white pb-14 pt-4 md:pb-20 md:pt-6">
  <div class="wrap">
    <div
      class="relative overflow-hidden rounded-card bg-navy px-7 py-12 text-center md:px-12 md:py-16"
      data-reveal
    >
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(70%_120%_at_50%_0%,rgb(0_136_248/0.42)_0%,transparent_65%)]"
        aria-hidden="true"
      >
      </div>

      <div class="relative mx-auto max-w-2xl">
        <h2 class="text-[28px] font-black text-white md:text-[40px]">{title}</h2>
        <p class="mt-4 text-[17px] leading-relaxed text-white/85 md:text-[19px]">{text}</p>

        <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
          <Button href={SITE.bookingUrl} variant="onNavy" icon="calendar" cta="book" service={service} wide>
            Book Online Now
          </Button>
          <Button href={whatsappHref} variant="whatsapp" icon="whatsapp" cta="whatsapp" service={service} wide>
            WhatsApp Us
          </Button>
        </div>

        <p class="mt-7 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[15px] text-white/80">
          <span class="flex items-center gap-2">
            <Icon name="clock" size={18} />
            {SITE.hours}
          </span>
          <span class="flex items-center gap-2">
            <Icon name="phone" size={18} />
            <a href={`tel:${SITE.phone}`} class="font-bold text-white underline underline-offset-4">
              {SITE.phoneDisplay}
            </a>
          </span>
        </p>
      </div>
    </div>
  </div>
</section>
