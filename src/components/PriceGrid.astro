---
import Icon from './Icon.astro'
import type { IconName } from './Icon.astro'
import { prices, rm, fromPrice, SITE } from '../data/site'

// Every price is rendered from src/data/prices.json so the page and the booking
// form cannot drift apart.
//
// The list doubles as a quote builder. Untouched it reads as a plain price
// table, which is what it is with JavaScript off. Tap a stepper and it totals
// the job and writes the itemised quote into the WhatsApp message, so an
// enquiry arrives as "2x 2 Seater, 1x Queen, RM424" rather than "how much?".
interface Props {
  groups: string[]
  service: string
  footnote?: string
  /** Extra line inside a group card, keyed by group name. */
  notes?: Record<string, string>
  /** Prefilled WhatsApp text used until the visitor picks something. */
  whatsappHref: string
}
const { groups, service, footnote, notes = {}, whatsappHref } = Astro.props as Props
---

<div data-quote data-service={service} data-wa-number={SITE.whatsapp}>
  <div class="grid gap-6 md:grid-cols-2">
    {
      groups.map((key) => {
        const group = prices.groups[key]
        return (
          <div
            class="flex flex-col rounded-card border border-brand-line bg-white p-6 shadow-soft md:p-8"
            data-reveal
          >
            <div class="flex items-center gap-4">
              <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-brand-circle text-brand-dark">
                <Icon name={group.icon as IconName} size={28} />
              </span>
              <div>
                <h3 class="text-[22px] font-black md:text-[24px]">{group.label} cleaning</h3>
                <p class="text-[14px] font-bold uppercase tracking-wide text-brand-ink">
                  From {rm(fromPrice(key))} {group.unit}
                </p>
              </div>
            </div>

            <ul class="mt-6 flex flex-col">
              {group.items.map((item, index) => (
                <li
                  class={`flex flex-wrap items-center justify-between gap-x-4 gap-y-3 py-3.5 ${index > 0 ? 'border-t border-brand-line' : ''}`}
                >
                  <span class="text-[17px] font-bold text-navy">{item.name}</span>

                  <span class="flex items-center gap-3.5">
                    <span class="text-[20px] font-black text-brand-dark">{rm(item.price)}</span>

                    <span
                      class="flex items-center gap-1 rounded-full bg-brand-tint p-1"
                      data-stepper
                      data-price={item.price}
                      data-name={`${item.name} ${group.label.toLowerCase()}`}
                    >
                      <button
                        type="button"
                        class="press flex h-9 w-9 items-center justify-center rounded-full text-navy transition-colors hover:bg-white disabled:opacity-35"
                        data-step="-1"
                        aria-label={`Remove one ${item.name} ${group.label.toLowerCase()}`}
                        disabled
                      >
                        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14" /></svg>
                      </button>

                      <output
                        class="w-5 text-center text-[16px] font-black tabular-nums text-navy"
                        data-count
                        aria-label={`${item.name} ${group.label.toLowerCase()} quantity`}
                      >
                        0
                      </output>

                      <button
                        type="button"
                        class="press flex h-9 w-9 items-center justify-center rounded-full text-navy transition-colors hover:bg-white"
                        data-step="1"
                        aria-label={`Add one ${item.name} ${group.label.toLowerCase()}`}
                      >
                        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                      </button>
                    </span>
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-4 grow">
              <p class="text-[14px]">Price shown is {group.unit}.</p>
              {notes[key] && (
                <p class="mt-4 rounded-2xl bg-brand-tint px-4 py-3 text-[15px] leading-relaxed text-navy">
                  {notes[key]}
                </p>
              )}
            </div>
          </div>
        )
      })
    }
  </div>

  {footnote && <p class="mt-7 text-center text-[16px]" set:html={footnote} />}

  <div class="mt-8" data-reveal>
    <div class="mx-auto max-w-3xl rounded-card border-2 border-brand-line bg-white p-6 shadow-soft md:p-8">
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
        <div>
          <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-brand-ink">
            Your estimate
          </p>
          <p
            class="mt-1 text-[15px] leading-snug"
            data-quote-summary
            aria-live="polite"
          >
            Add what you need above and the total works itself out.
          </p>
        </div>
        <p class="text-[34px] font-black leading-none tabular-nums text-navy md:text-[40px]">
          <span data-quote-total>{prices.prefix}0</span>
        </p>
      </div>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a
          href={SITE.bookingUrl}
          class="press inline-flex flex-1 items-center justify-center gap-2.5 rounded-full bg-brand-dark px-7 py-4 text-[18px] font-bold leading-none text-white transition-colors hover:bg-[#005FB4]"
          data-cta="book"
          data-service={service}
          rel="noopener"
        >
          <Icon name="calendar" size={22} />
          Book Online Now
        </a>
        <a
          href={whatsappHref}
          class="press inline-flex flex-1 items-center justify-center gap-2.5 rounded-full bg-wa px-7 py-4 text-[18px] font-bold leading-none text-navy transition-colors hover:bg-[#00b94d]"
          data-cta="whatsapp"
          data-service={service}
          data-quote-wa
          target="_blank"
          rel="noopener"
        >
          <Icon name="whatsapp" size={22} />
          <span data-quote-wa-label>WhatsApp Us</span>
        </a>
      </div>

      <p class="mt-5 flex items-center justify-center gap-2 text-center text-[15px] font-bold text-navy">
        <Icon name="check" size={18} class="shrink-0 text-brand-dark" />
        {prices.note}
      </p>
      <p class="mt-2 text-center text-[14px]">
        Your card is charged only after the appointment is completed. The amount is held one day
        before the session.
      </p>
    </div>
  </div>
</div>

<script>
  // Quote builder. Progressive enhancement: with this script blocked the page
  // is still a readable price list and the buttons simply do nothing.
  for (const root of document.querySelectorAll<HTMLElement>('[data-quote]')) {
    const steppers = [...root.querySelectorAll<HTMLElement>('[data-stepper]')]
    const totalEl = root.querySelector<HTMLElement>('[data-quote-total]')
    const summaryEl = root.querySelector<HTMLElement>('[data-quote-summary]')
    const waLink = root.querySelector<HTMLAnchorElement>('[data-quote-wa]')
    const waLabel = root.querySelector<HTMLElement>('[data-quote-wa-label]')
    if (!totalEl || !summaryEl || !waLink || !waLabel) continue

    const waNumber = root.dataset.waNumber
    const baseHref = waLink.href
    const counts = new Map<HTMLElement, number>()

    const render = () => {
      const picked: { name: string; count: number }[] = []
      let total = 0

      for (const stepper of steppers) {
        const count = counts.get(stepper) || 0
        if (count === 0) continue
        total += count * Number(stepper.dataset.price)
        picked.push({ name: String(stepper.dataset.name), count })
      }

      totalEl.textContent = `RM${total}`

      if (picked.length === 0) {
        summaryEl.textContent = 'Add what you need above and the total works itself out.'
        waLink.href = baseHref
        waLabel.textContent = 'WhatsApp Us'
        return
      }

      const itemised = picked.map((item) => `${item.count}x ${item.name}`).join(', ')
      const plural = picked.reduce((sum, item) => sum + item.count, 0)
      summaryEl.textContent = `${plural} item${plural === 1 ? '' : 's'}: ${itemised}`

      // The enquiry now arrives qualified rather than as "how much?".
      const message = `Hi Kleaner, I'd like to book: ${itemised}. Estimated total RM${total}.`
      waLink.href = `https://wa.me/${waNumber}?text=${encodeURIComponent(message)}`
      waLabel.textContent = 'Send this on WhatsApp'

      // Every other WhatsApp control on the page carries the quote too, so it
      // does not matter which one they reach for.
      for (const other of document.querySelectorAll<HTMLAnchorElement>('a[data-cta="whatsapp"]')) {
        other.href = waLink.href
      }
    }

    for (const stepper of steppers) {
      const output = stepper.querySelector<HTMLElement>('[data-count]')
      const minus = stepper.querySelector<HTMLButtonElement>('[data-step="-1"]')
      if (!output || !minus) continue

      stepper.addEventListener('click', (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>('[data-step]')
        if (!button) return

        const next = Math.max(0, Math.min(20, (counts.get(stepper) || 0) + Number(button.dataset.step)))
        counts.set(stepper, next)
        output.textContent = String(next)
        minus.disabled = next === 0
        render()
      })
    }
  }
</script>
