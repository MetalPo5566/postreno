---
// One visible, deliberately loud note for anything that is not a verified fact.
// scripts/gen-owner-confirm.mjs collects every one of these into
// content/OWNER-CONFIRM.md, and scripts/verify.mjs checks that none of them
// ever reaches the structured data.
interface Props {
  /** Optional label for the thing being confirmed, shown before the ask. */
  subject?: string
  class?: string
}
const { subject, class: className = '' } = Astro.props as Props
---

<p
  class={`rounded-2xl border border-[#F0C36D] bg-[#FFF8E8] px-4 py-3 text-[15px] leading-relaxed text-[#6B4A00] ${className}`}
  data-confirm
>
  <strong class="font-black">[OWNER TO CONFIRM]</strong>{subject && <> {subject}:</>}
  <slot />
</p>
