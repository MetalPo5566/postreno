---
// Drag slider. The input is a real range control, so dragging, tapping and the
// arrow keys all work without extra code, and screen readers announce it.
interface Props {
  before: string
  after: string
  beforeAlt: string
  afterAlt: string
  label?: string
  /** Full caption under the slider. Defaults to the English wording. */
  caption?: string
  beforeLabel?: string
  afterLabel?: string
}
const {
  before,
  after,
  beforeAlt,
  afterAlt,
  label = 'Drag to compare before and after',
  caption = `${label}. Photos are placeholders until we add real job photos.`,
  beforeLabel = 'Before',
  afterLabel = 'After',
} = Astro.props as Props
---

<figure class="mx-auto max-w-3xl" data-reveal>
  <div class="relative aspect-[4/3] overflow-hidden rounded-card shadow-soft" data-compare>
    <img
      src={after}
      alt={afterAlt}
      width="1040"
      height="780"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <img
      src={before}
      alt={beforeAlt}
      width="1040"
      height="780"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
      style="clip-path: inset(0 50% 0 0)"
      data-compare-before
    />

    <span
      class="pointer-events-none absolute left-4 top-4 rounded-full bg-navy/85 px-3.5 py-1.5 text-[13px] font-bold uppercase tracking-wide text-white"
    >
      {beforeLabel}
    </span>
    <span
      class="pointer-events-none absolute right-4 top-4 rounded-full bg-white/90 px-3.5 py-1.5 text-[13px] font-bold uppercase tracking-wide text-navy"
    >
      {afterLabel}
    </span>

    <div
      class="pointer-events-none absolute inset-y-0 w-1 -translate-x-1/2 bg-white shadow-[0_0_0_1px_rgb(17_38_60/0.15)]"
      style="left: 50%"
      data-compare-line
    >
      <span
        class="absolute top-1/2 left-1/2 flex h-12 w-12 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-navy shadow-lift"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m10 7-5 5 5 5M14 7l5 5-5 5"></path>
        </svg>
      </span>
    </div>

    <input
      type="range"
      min="0"
      max="100"
      value="50"
      step="1"
      class="compare-range absolute inset-0 h-full w-full cursor-ew-resize appearance-none bg-transparent"
      aria-label={label}
      data-compare-input
    />
  </div>
  <figcaption class="mt-4 text-center text-[15px]">{caption}</figcaption>
</figure>

<style>
  .compare-range::-webkit-slider-thumb {
    appearance: none;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: transparent;
    cursor: ew-resize;
  }

  .compare-range::-moz-range-thumb {
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: ew-resize;
  }

  .compare-range:focus-visible {
    outline-offset: -4px;
  }

  /* The slider handles horizontal, the browser keeps vertical panning, so a
     drag on the image never fights the page scroll. */
  .compare-range {
    touch-action: pan-y;
  }
</style>

<script>
  for (const frame of document.querySelectorAll<HTMLElement>('[data-compare]')) {
    const input = frame.querySelector<HTMLInputElement>('[data-compare-input]')
    const beforeImage = frame.querySelector<HTMLElement>('[data-compare-before]')
    const line = frame.querySelector<HTMLElement>('[data-compare-line]')
    if (!input || !beforeImage || !line) continue

    const paint = () => {
      const position = Number(input.value)
      beforeImage.style.clipPath = `inset(0 ${100 - position}% 0 0)`
      line.style.left = `${position}%`
    }

    input.addEventListener('input', paint)
    paint()

    // Nudge the handle once when the slider first comes into view, so it reads
    // as something to drag rather than a line across a photo. Runs once, and
    // any real interaction cancels it.
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (reduced || !('IntersectionObserver' in window)) continue

    let hinted = false
    let cancelled = false
    const cancel = () => {
      cancelled = true
    }
    input.addEventListener('pointerdown', cancel, { once: true })
    input.addEventListener('keydown', cancel, { once: true })

    const hint = () => {
      const from = 50
      const to = 66
      const duration = 1100
      const startedAt = performance.now()

      const step = (now: number) => {
        if (cancelled) return
        const t = Math.min(1, (now - startedAt) / duration)
        // Out and back on one sine arc, so it settles exactly where it started.
        const eased = Math.sin(t * Math.PI)
        input.value = String(from + (to - from) * eased)
        paint()
        if (t < 1) requestAnimationFrame(step)
      }

      requestAnimationFrame(step)
    }

    const watcher = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting || hinted) continue
          hinted = true
          watcher.disconnect()
          window.setTimeout(hint, 350)
        }
      },
      { threshold: 0.55 }
    )
    watcher.observe(frame)
  }
</script>
